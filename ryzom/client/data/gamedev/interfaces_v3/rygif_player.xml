				tx_normal="W_slot_blason_over.tga"
				tx_over="blank.tga"
				tx_pushed="blank.tga"
				scale="true"
				w="#w"
				h="#h"
				tooltip="#tooltip"
				color="255 255 255 0"
				col_over="255 200 255 50"
				col_pushed="200 200 255 50"
