	<!-- //////////// TEMPLATE : for rygif player /////////// -->
	<template name="rygif_player" render_layer1="1" render_layer2="2" keep="true" tooltip="" w="40" h="40" stop_play="" texture_img="" x="0" y="0" stop_play_x="0" stop_play_y="0" lua_left_function="" lua_over_function="" lua_right_function="" ctrl_active="true" >
		<group id="#id" posref="MM MM" w="#w" h="#h" x="#x" y="#y" sizeref="" render_layer="#render_layer1">
			<view type="bitmap" posref="ML ML" render_layer="#render_layer1"
				id="texture_img"
				x="#x"
				y="#y"
				w="#w"
				h="#h"
				scale="true"
				resize="true"
				texture="#texture_img"
				global_color="false" />
			<view type="bitmap" posref="ML ML" render_layer="#render_layer2"
				id="stop_play"
				x="#stop_play_x"
				y="#stop_play_y"
				w="#w"
				h="#h"
				scale="true"
				resize="true"
				texture="#stop_play"
				global_color="false" />
