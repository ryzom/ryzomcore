# The author loads a scenario of the versions before this editor and adds a dialog, which the scenario
# had none of; then the editor connects again and gets the scenario from the server, whose list of
# versions does not name the class of the dialog. Every class the list names is at the version of the
# editor, and the update has nothing to look at.
early_return_version_before: current=yes
absent: early_return_version_update
absent: early_return_upload

upgrade: unchanged
version_update: unchanged
absent: version_update_note

save: ok
roundtrip: ok
reload_version_update: current
reload_version_before: current=yes
translate: ok
rt_check: ok
rt_check_serial: ok
absent: dropped_update
absent: late_update
absent: version_update_failure
return_version_before: current=yes
absent: return_version_update
absent: return_upload

edit: ok class=ChatSequence
server_at: Versions.ChatSequence = 2
server_at: Acts[1].Features[1].Class = ChatSequence
server_at: Acts[1].Features[1].Active = 0
scenario_at: Acts[1].Features[1].Active = 0
