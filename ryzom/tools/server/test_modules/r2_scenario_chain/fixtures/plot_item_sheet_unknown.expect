# Plot items whose sheet is no plot item sheet and that the update has no plot item sheet for: the light
# boots (iccalb.sitem, whose icon no plot item sheet shows), a raw material that is not in the table of
# the update, and a number that lies between the numbers of two plot item sheets and is a sheet of
# another type. The update guesses nothing: they keep their sheet, the scenario is as it was (but for its
# list of versions), and the author is told which plot items to choose an icon for. The scenario service
# refuses them when the scenario starts, as before.

upgrade: unchanged
version_update: unchanged
version_update_note: uiR2EDVersionNotePlotItemUnknown(Light boots, 8448814)
version_update_note: uiR2EDVersionNotePlotItemUnknown(Between the numbers, 8630313)
version_update_note: uiR2EDVersionNotePlotItemUnknown(Fine material, 8387118)
no_line: version_update_note: uiR2EDVersionNotePlotItemUnknown(Old key
no_line: version_update_note: uiR2EDVersionNotePlotItemIcon

scenario_vs_file: same
save: ok
roundtrip: ok
reload_version_update: current
translate: ok
rt_check: ok
rt_check_serial: ok
rt_plot_item_sheets:
no_line: rt_plot_item_sheets: ok
absent: version_update_failure

scenario_at: Versions.PlotItem = 1
scenario_at: PlotItems[0].SheetId = 8448814
scenario_at: PlotItems[1].SheetId = 8632366
scenario_at: PlotItems[2].SheetId = 8630313
scenario_at: PlotItems[3].SheetId = 8387118
rt_at: PlotItems[0].SheetId = 8448814
rt_at: PlotItems[2].SheetId = 8630313
rt_at: PlotItems[3].SheetId = 8387118
