# A scenario the server kept from an earlier editor, with a dialog and a counter its author added after
# the list of versions was made: the list names neither class. Their components can be of any version,
# and the steps of both classes run from the first version on: they leave the dialog and the counter,
# which are up to date, as they are.

upgrade: unchanged
version_update: unchanged
absent: version_update_note
scenario_vs_file: same

save: ok
roundtrip: ok
reload_version_update: current
reload_version_before: current=yes
translate: ok
rt_check: ok
rt_check_serial: ok
absent: dropped_update
absent: late_update
absent: version_update_failure
return_version_before: current=yes
absent: return_version_update
absent: return_upload

version_update_steps: Act:6>7=2,ActiveLogicEntity:0>1=1,ChatSequence:0>2=1,Counter:0>2=1,Location:1>2=1,LogicEntity:0>1=6,Scenario:4>6=1,WorldObject:0>1=6
scenario_at: Acts[1].Features[1].Class = ChatSequence
scenario_at: Acts[1].Features[1].Active = 0
scenario_at: Acts[1].Features[1].AutoStart = 1
scenario_at: Acts[1].Features[2].TriggerValue = 0
scenario_at: Versions.ChatSequence = 2
scenario_at: Versions.Counter = 2
