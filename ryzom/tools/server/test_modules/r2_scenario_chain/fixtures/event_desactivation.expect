# A chest with a handler of the event "desactivation", the name earlier versions gave "deactivation".

upgrade: ok
version_update: changed

save: ok
roundtrip: ok
reload_version_update: current
reload_version_before: current=yes
translate: ok
rt_check: ok
rt_check_serial: ok
absent: dropped_update
absent: late_update
absent: version_update_failure
return_version_before: current=yes
absent: return_version_update
absent: return_upload

absent: version_update_note
scenario_at: Acts[1].Features[1].Class = EasterEgg
scenario_at: Acts[1].Features[1].Behavior.Actions[0].Event.Type = deactivation
scenario_lacks: Type = [[desactivation]]
