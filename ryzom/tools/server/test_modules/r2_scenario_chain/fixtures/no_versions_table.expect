# A scenario without a Versions table and without a version name, which has every part a scenario has:
# every class counts as of its first version, no step has anything to change, and the save gives the
# scenario its Versions table.

upgrade: unchanged
version_update: unchanged
absent: version_update_note
scenario_vs_file: same

save: ok
roundtrip: ok
reload_version_update: current
reload_version_before: current=yes
translate: ok
rt_check: ok
rt_check_serial: ok
absent: dropped_update
absent: late_update
absent: version_update_failure
return_version_before: current=yes
absent: return_version_update
absent: return_upload

scenario_at: Versions.Scenario = 6
scenario_at: Versions.Act = 7
scenario_at: Versions.Location = 2
scenario_at: VersionName = <none>
