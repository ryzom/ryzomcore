# Steps of 4 and of -3 seconds: the step keeps its time, whose timer comes at once, and its seconds
# are not taken off the time limit. (10 + 3) + (41 + 3) + (4 + 3) + (2 + 3) = 69 ticks: 7 seconds.
scenario_at: Acts[1].Features[5].Name = Zora Back
scenario_at: Acts[1].Features[5].Components[1].Time = -3
