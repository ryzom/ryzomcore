rt_has: ()setTimer(81, 0);
rt_has: ()r2_0001_RtNpcGrp_7.setTimer(14, 1);

# Three actions, the npcs of the first and the second turn: times 5, 1 and 1.
# (10 + 3) + (51 + 3) + (14 + 3) + (14 + 3) + (2 + 3) = 106 ticks: 11 seconds.
scenario_at: Acts[1].Features[4].Name = Zora Both
scenario_at: Acts[1].Features[4].Components[0].Time = 5
