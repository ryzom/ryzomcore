# Five npcs that move as the first editors kept it, in their behavior: one wanders in a zone, one
# follows a road, one wanders in a zone the scenario does not have, one patrols on the road and one
# walks it again and again. Each gets an activity sequence that says the same; the one without its zone
# stands still, and the author is told.

upgrade: ok
version_update: changed

save: ok
roundtrip: ok
reload_version_update: current
reload_version_before: current=yes
translate: ok
rt_check: ok
rt_check_serial: ok
absent: dropped_update
absent: late_update
absent: version_update_failure
return_version_before: current=yes
absent: return_version_update
absent: return_upload

version_update_note: uiR2EDVersionNoteLostMovements(1)
scenario_at: Acts[1].Features[0].Components[2].Behavior.Type = <empty>
scenario_at: Acts[1].Features[0].Components[2].Behavior.ZoneId = <empty>
scenario_at: Acts[1].Features[0].Components[2].Behavior.Activities = <size 1>
scenario_at: Acts[1].Features[0].Components[2].Behavior.Activities[0].Class = ActivitySequence
scenario_at: Acts[1].Features[0].Components[2].Behavior.Activities[0].Components = <size 1>
scenario_at: Acts[1].Features[0].Components[2].Behavior.Activities[0].Components[0].Activity = Wander
scenario_at: Acts[1].Features[0].Components[2].Behavior.Activities[0].Components[0].ActivityZoneId = Client1_860
scenario_at: Acts[1].Features[0].Components[2].Behavior.Activities[0].Components[0].TimeLimit = No Limit
scenario_at: Acts[1].Features[0].Components[3].Behavior.Activities[0].Components[0].Activity = Follow Route
scenario_at: Acts[1].Features[0].Components[3].Behavior.Activities[0].Components[0].ActivityZoneId = Client1_861
scenario_at: Acts[1].Features[0].Components[4].Behavior.Type = <empty>
scenario_at: Acts[1].Features[0].Components[4].Behavior.Activities = <size 0>
scenario_at: Acts[1].Features[0].Components[5].Behavior.Type = <empty>
scenario_at: Acts[1].Features[0].Components[5].Behavior.Activities[0].Components[0].Activity = Patrol
scenario_at: Acts[1].Features[0].Components[5].Behavior.Activities[0].Components[0].ActivityZoneId = Client1_861
scenario_at: Acts[1].Features[0].Components[6].Behavior.Activities[0].Components[0].Activity = Repeat Road
scenario_at: Acts[1].Features[0].Components[6].Behavior.Activities[0].Components[0].TimeLimit = No Limit
rt_at: Acts[1].Npcs = <size 5>
