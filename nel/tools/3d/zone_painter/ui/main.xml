<interface_config>

<!-- Master group: viewer is 800x600 (matches kMainWidth/kMainHeight). -->
<root id="zp" x="0" y="0" w="800" h="600" active="true" />

<define id="case_normal" value="0" />
<define id="case_lower" value="1" />
<define id="case_upper" value="2" />

<!-- Mouse pointer (textures from the interface atlas) -->
<group id="pointer_layer" posref="BL BL" x="0" y="0" sizeref="wh" w="0" h="0" active="true">
	<view type="generic_pointer" id="pointer" posref="BL BL" x="0" y="0" w="32" h="32"
		color="255 255 255 255"
		tx_default="curs_default.tga"
		tx_move_window="curs_default.tga"
		tx_colpick="curs_pick.tga"
		tx_pan="curs_pan.tga"
		tx_can_pan="curs_can_pan.tga" />
</group>

<!-- ===================================================================== -->
<!-- Startup row templates (filled at runtime via createGroupInstance)     -->
<!-- ===================================================================== -->

<!-- World row: primary button + path subtitle. idx is the worlds[] index. -->
<template name="zp_world_row" keep="true" id="" title="" subtitle="" idx="0">
	<group id="#id" w="520" h="40">
		<ctrl style="text_button_16_name" id="btn" posref="TL TL" x="4" y="-2" w="500"
			hardtext="#title" onclick_l="zp_select_world" params_l="#idx" />
		<view type="text" id="sub" posparent="btn" posref="BL TL" x="6" y="-1" fontsize="10" shadow="true"
			global_color="false" color="180 190 200 200" hardtext="#subtitle" />
	</group>
</template>

<!-- Zone row (ecosystem list): optional 32x32 thumb + open button. idx is zones[] index.
     Code deactivates thumb when no embedded/.png preview exists (no empty dark square). -->
<template name="zp_zone_row" keep="true" id="" title="" idx="0" thumb="">
	<group id="#id" w="560" h="36">
		<view type="bitmap" id="thumb" posref="ML ML" x="4" y="0" w="32" h="32" scale="true"
			texture="#thumb" global_color="false" color="255 255 255 255" active="false" />
		<ctrl style="text_button_16_name" id="btn" posparent="thumb" posref="MR ML" x="8" y="0" w="500"
			hardtext="#title" onclick_l="zp_select_zone" params_l="#idx" />
	</group>
</template>

<!-- Continent board cell (M5a): minesweeper-style square stamp (ms_cell idiom).
     Brick cover is the hit target; name + optional thumb draw above it (later siblings). -->
<template name="zp_board_cell" keep="true" id="" title="" idx="0" thumb="">
	<group id="#id" w="52" h="52">
		<!-- Brick face = minesweeper cover; R-click toggles multi-select (M6b); L-click opens. -->
		<ctrl type="button" id="btn" button_type="toggle_button" posref="MM MM" x="0" y="0"
			scale="true" sizeref="wh" w="-2" h="-2"
			tx_normal="w_slot_brick.tga" tx_pushed="w_slot_brick_selected.tga" tx_over="w_slot_brick_selected.tga"
			global_color_normal="false" global_color_pushed="false" global_color_over="false"
			onclick_l="zp_select_zone" params_l="#idx"
			onclick_r="zp_toggle_zone_select" params_r="#idx" />
		<!-- Optional embedded/.png thumb (M5b activates when a cache path exists). -->
		<view type="bitmap" id="thumb" posref="TM TM" x="0" y="-4" w="40" h="24" scale="true"
			texture="#thumb" global_color="false" active="false" />
		<view type="text" id="t" posref="BM BM" x="0" y="4" fontsize="10" shadow="true"
			global_color="false" color="255 255 255 255" hardtext="#title" />
	</group>
</template>

<!-- Empty fringe cell: visibly empty, non-interactive placeholder (no button). -->
<template name="zp_board_empty" keep="true" id="">
	<group id="#id" w="52" h="52">
		<view type="bitmap" id="bg" posref="MM MM" scale="true" sizeref="wh" w="-2" h="-2"
			texture="w_box_blank.tga" global_color="false" color="45 48 56 220" />
	</group>
</template>

<!-- Folder browser row (M2c): directory name button. -->
<template name="zp_folder_row" keep="true" id="" title="" path="">
	<group id="#id" w="520" h="28">
		<ctrl style="text_button_16_name" id="btn" posref="TL TL" x="4" y="-2" w="500"
			hardtext="#title" onclick_l="zp_folder_enter" params_l="#path" />
	</group>
</template>

<!-- ===================================================================== -->
<!-- Screen A — world select                                               -->
<!-- ===================================================================== -->
<group type="container" id="world_select" w="560" pop_min_w="480" pop_max_w="700" h="480" pop_min_h="360" pop_max_h="580"
	title="zone_painter — choose world" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="false" x="120" y="540">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<view type="text" id="hint" posref="TL TL" x="12" y="-8" fontsize="11" shadow="true"
			global_color="false" color="255 255 255 160" hardtext="Pick an ecosystem or continent. ESC quits." />
		<view type="text" id="status" posparent="hint" posref="BL TL" x="0" y="-4" fontsize="11" shadow="true"
			global_color="false" color="255 200 120 220" hardtext="" />

		<!-- Scrollable stack of world rows (list id must be text_list for scroll_text) -->
		<group type="scroll_text" id="list_scroll" posparent="status" posref="BL TL" x="0" y="-8" w="530" h="360" min_height="200" max_height="400">
			<group type="list" id="text_list" shadow="true" fontsize="12" color="255 255 255 255" space="2"
				global_color="false" posref="TL TL" x="4" y="-4" sizeref="hw" w="-24" h="-8" maxelements="500" />
			<ctrl type="scroll" id="scroll_bar" align="T" posref="TR TR" x="-4" y="-4" w="8" sizeref="h" h="-8"
				tx_topright="w_scroll_l0_t.tga" tx_middle="w_scroll_l0_m.tga" tx_bottomleft="w_scroll_l0_b.tga" />
		</group>

		<ctrl style="text_button_16" id="btn_browse" posparent="list_scroll" posref="BL TL" x="4" y="-10"
			onclick_l="zp_browse" params_l="" hardtext="Browse..." />
		<ctrl style="text_button_16" id="btn_quit" posparent="btn_browse" posref="MR ML" x="8" y="0"
			onclick_l="zp_startup_quit" params_l="" hardtext="Quit" />
	</group>
</group>
<tree node="world_select"></tree>

<!-- ===================================================================== -->
<!-- Screen B — zone browser (list for ecosystems; name-grid for continents) -->
<!-- ===================================================================== -->
<group type="container" id="zone_browser" w="780" pop_min_w="480" pop_max_w="790" h="500" pop_min_h="360" pop_max_h="580"
	title="zone_painter — choose zone" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="false" x="10" y="550">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<view type="text" id="world_title" posref="TL TL" x="12" y="-8" fontsize="13" shadow="true"
			global_color="false" color="180 220 255 255" hardtext="World" />
		<view type="text" id="world_sub" posparent="world_title" posref="BL TL" x="0" y="-2" fontsize="10" shadow="true"
			global_color="false" color="180 190 200 200" hardtext="" />

		<!-- Ecosystem open layout (self-instances, M4b). Hidden on continents (active toggled in code). -->
		<view type="text" id="layout_label" posparent="world_sub" posref="BL TL" x="0" y="-6" fontsize="11" shadow="true"
			global_color="false" color="255 255 255 180" hardtext="Open layout (self-instances):" active="false" />
		<ctrl style="text_button_radio" id="layout_1x1" posparent="layout_label" posref="BL TL" x="0" y="-2"
			pushed="true" onclick_l="zp_set_instances" params_l="1x1" hardtext="1x1" active="false" />
		<ctrl style="text_button_radio" id="layout_2x1" posparent="layout_1x1" posref="MR ML" x="4" y="0"
			onclick_l="zp_set_instances" params_l="2x1" hardtext="2x1" active="false" />
		<ctrl style="text_button_radio" id="layout_1x2" posparent="layout_2x1" posref="MR ML" x="4" y="0"
			onclick_l="zp_set_instances" params_l="1x2" hardtext="1x2" active="false" />
		<ctrl style="text_button_radio" id="layout_2x2" posparent="layout_1x2" posref="MR ML" x="4" y="0"
			onclick_l="zp_set_instances" params_l="2x2" hardtext="2x2" active="false" />
		<ctrl style="text_button_radio" id="layout_3x3" posparent="layout_2x2" posref="MR ML" x="4" y="0"
			onclick_l="zp_set_instances" params_l="3x3" hardtext="3x3" active="false" />

		<!-- Ecosystem list: vertical scroll_text (unchanged). y: -8 under world_sub or below layout row. -->
		<group type="scroll_text" id="list_scroll" posparent="world_sub" posref="BL TL" x="0" y="-8" w="750" h="350" min_height="180" max_height="400">
			<group type="list" id="text_list" shadow="true" fontsize="12" color="255 255 255 255" space="1"
				global_color="false" posref="TL TL" x="4" y="-4" sizeref="hw" w="-24" h="-8" maxelements="2000" />
			<ctrl type="scroll" id="scroll_bar" align="T" posref="TR TR" x="-4" y="-4" w="8" sizeref="h" h="-8"
				tx_topright="w_scroll_l0_t.tga" tx_middle="w_scroll_l0_m.tga" tx_bottomleft="w_scroll_l0_b.tga" />
		</group>

		<!-- Continent board (M5a): minesweeper-style cell stamps + dual-axis scroll (interface_notes pattern).
		     board.w/h = content size (set in code); max_w/max_h = viewport clip.
		     Scroll targets use absolute ids (relative "board" fails while board_host starts inactive). -->
		<group id="board_host" posparent="world_sub" posref="BL TL" x="0" y="-8" w="750" h="350" active="false">
			<group id="board" posref="TL TL" x="0" y="0" w="52" h="52" max_w="730" max_h="330">
			</group>
			<ctrl type="scroll" id="sv" posref="TR TR" x="-2" y="0" w="8" h="330" align="T"
				tx_topright="w_scroll_l0_t.tga" tx_middle="w_scroll_l0_m.tga" tx_bottomleft="w_scroll_l0_b.tga"
				target="ui:zp:zone_browser:content:board_host:board" />
			<ctrl type="scroll" id="sh" posref="BL BL" x="0" y="2" w="730" h="8" vertical="false" align="L"
				tx_topright="w_scroll_r.tga" tx_middle="w_scroll_m.tga" tx_bottomleft="w_scroll_l.tga"
				target="ui:zp:zone_browser:content:board_host:board" />
		</group>

		<!-- Legend + multi-open (M6b/M6c). Back stays content-anchored for list and board modes. -->
		<view type="text" id="board_legend" posref="BL BL" x="12" y="36" fontsize="10" shadow="true"
			global_color="false" color="180 190 200 200"
			hardtext="L-click open · R-click select · fringe = empty" active="false" />
		<ctrl style="text_button_16" id="btn_back" posref="BL BL" x="12" y="12"
			onclick_l="zp_zone_back" params_l="" hardtext="Back" />
		<ctrl style="text_button_16" id="btn_open_sel" posparent="btn_back" posref="MR ML" x="8" y="0"
			onclick_l="zp_open_selection" params_l="" hardtext="Open selection" active="false" />
	</group>
</group>
<tree node="zone_browser"></tree>

<!-- ===================================================================== -->
<!-- Screen C — folder browser (M2c; inactive until enabled)               -->
<!-- ===================================================================== -->
<group type="container" id="folder_browser" w="560" pop_min_w="480" pop_max_w="700" h="460" pop_min_h="320" pop_max_h="560"
	title="zone_painter — browse for graphics" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="false" x="120" y="520">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<view type="text" id="path_label" posref="TL TL" x="12" y="-8" fontsize="11" shadow="true"
			global_color="false" color="180 220 255 255" hardtext="/" />
		<view type="text" id="status" posparent="path_label" posref="BL TL" x="0" y="-4" fontsize="11" shadow="true"
			global_color="false" color="255 200 120 220" hardtext="" />

		<group type="scroll_text" id="list_scroll" posparent="status" posref="BL TL" x="0" y="-8" w="530" h="320" min_height="160" max_height="380">
			<group type="list" id="text_list" shadow="true" fontsize="12" color="255 255 255 255" space="2"
				global_color="false" posref="TL TL" x="4" y="-4" sizeref="hw" w="-24" h="-8" maxelements="500" />
			<ctrl type="scroll" id="scroll_bar" align="T" posref="TR TR" x="-4" y="-4" w="8" sizeref="h" h="-8"
				tx_topright="w_scroll_l0_t.tga" tx_middle="w_scroll_l0_m.tga" tx_bottomleft="w_scroll_l0_b.tga" />
		</group>

		<ctrl style="text_button_16" id="btn_select" posparent="list_scroll" posref="BL TL" x="4" y="-10"
			onclick_l="zp_folder_select" params_l="" hardtext="Select this folder" />
		<ctrl style="text_button_16" id="btn_cancel" posparent="btn_select" posref="MR ML" x="8" y="0"
			onclick_l="zp_folder_cancel" params_l="" hardtext="Cancel" />
	</group>
</group>
<tree node="folder_browser"></tree>

<!--
  Painter control panel (M1c). Inactive until the viewer starts (startup flow hides it).
  Top-right corner keeps the terrain baseline visible in screenshots.
-->
<group type="container" id="painter" w="220" pop_min_w="200" pop_max_w="280" h="340" pop_min_h="280" pop_max_h="480"
	title="Painter" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="false" x="572" y="592">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">

		<!-- Instance indicator (M4b; empty when not self-instanced) -->
		<view type="text" id="instance_info" posref="TL TL" x="10" y="-6" fontsize="11" shadow="true"
			global_color="false" color="120 255 160 255" hardtext="" />

		<!-- Season variant toggle (M6a; frozen when <2 seasons resolve) -->
		<view type="text" id="season_info" posparent="instance_info" posref="BL TL" x="0" y="-4" fontsize="11" shadow="true"
			global_color="false" color="255 220 140 255" hardtext="Season: auto" />
		<ctrl style="text_button_16" id="btn_season" posparent="season_info" posref="MR ML" x="6" y="0"
			onclick_l="zp_season_next" params_l="" hardtext="Next" />

		<!-- Multi-file dirty indicator (M6b) -->
		<view type="text" id="files_info" posparent="season_info" posref="BL TL" x="0" y="-2" fontsize="10" shadow="true"
			global_color="false" color="200 200 210 220" hardtext="1 file" />

		<!-- Mode radio row -->
		<view type="text" id="lbl_mode" posparent="files_info" posref="BL TL" x="0" y="-6" fontsize="11" shadow="true"
			global_color="false" color="255 255 255 180" hardtext="Mode" />
		<ctrl style="text_button_radio" id="mode_tile" posparent="lbl_mode" posref="BL TL" x="0" y="-4"
			pushed="true" onclick_l="zp_mode" params_l="0" hardtext="Tile" />
		<ctrl style="text_button_radio" id="mode_color" posparent="mode_tile" posref="MR ML" x="4" y="0"
			onclick_l="zp_mode" params_l="1" hardtext="Color" />
		<ctrl style="text_button_radio" id="mode_displace" posparent="mode_color" posref="MR ML" x="4" y="0"
			onclick_l="zp_mode" params_l="2" hardtext="Disp" />

		<!-- Tile set -->
		<view type="text" id="lbl_tileset" posparent="mode_tile" posref="BL TL" x="0" y="-10" fontsize="11" shadow="true"
			global_color="false" color="255 255 255 180" hardtext="Tile set" />
		<view type="text" id="tileset_info" posparent="lbl_tileset" posref="BL TL" y="-2" fontsize="12" shadow="true"
			global_color="false" color="180 220 255 255" hardtext="0 / 0" />
		<ctrl style="text_button_16" id="tileset_prev" posparent="tileset_info" posref="BL TL" x="0" y="-4"
			onclick_l="zp_tileset" params_l="-1" hardtext="&lt;" />
		<ctrl style="text_button_16" id="tileset_next" posparent="tileset_prev" posref="MR ML" x="4" y="0"
			onclick_l="zp_tileset" params_l="+1" hardtext="&gt;" />
		<ctrl style="text_button_toggle" id="toggle_256" posparent="tileset_next" posref="MR ML" x="8" y="0"
			onclick_l="zp_toggle_256" params_l="" hardtext="256" />

		<!-- Brush size 0-2 -->
		<view type="text" id="lbl_brush" posparent="tileset_prev" posref="BL TL" x="0" y="-10" fontsize="11" shadow="true"
			global_color="false" color="255 255 255 180" hardtext="Brush size" />
		<view type="text" id="brush_info" posparent="lbl_brush" posref="MR ML" x="8" y="0" fontsize="12" shadow="true"
			global_color="false" color="180 220 255 255" hardtext="0" />
		<ctrl style="text_button_16" id="brush_down" posparent="lbl_brush" posref="BL TL" x="0" y="-4"
			onclick_l="zp_brush" params_l="-1" hardtext="-" />
		<ctrl style="text_button_16" id="brush_up" posparent="brush_down" posref="MR ML" x="4" y="0"
			onclick_l="zp_brush" params_l="+1" hardtext="+" />

		<!-- Tile group -->
		<view type="text" id="lbl_group" posparent="brush_down" posref="BL TL" x="0" y="-10" fontsize="11" shadow="true"
			global_color="false" color="255 255 255 180" hardtext="Group" />
		<view type="text" id="group_info" posparent="lbl_group" posref="MR ML" x="8" y="0" fontsize="12" shadow="true"
			global_color="false" color="180 220 255 255" hardtext="0" />
		<ctrl style="text_button_16" id="group_down" posparent="lbl_group" posref="BL TL" x="0" y="-4"
			onclick_l="zp_group" params_l="-1" hardtext="-" />
		<ctrl style="text_button_16" id="group_up" posparent="group_down" posref="MR ML" x="4" y="0"
			onclick_l="zp_group" params_l="+1" hardtext="+" />

		<!-- Lock borders -->
		<ctrl style="text_button_toggle" id="lock_borders" posparent="group_down" posref="BL TL" x="0" y="-10"
			onclick_l="zp_lock_borders" params_l="" hardtext="Lock borders" />

		<!-- Undo / redo / fill -->
		<ctrl style="text_button_16" id="btn_undo" posparent="lock_borders" posref="BL TL" x="0" y="-10"
			onclick_l="zp_undo" params_l="" hardtext="Undo" />
		<ctrl style="text_button_16" id="btn_redo" posparent="btn_undo" posref="MR ML" x="4" y="0"
			onclick_l="zp_redo" params_l="" hardtext="Redo" />
		<view type="text" id="undo_info" posparent="btn_redo" posref="MR ML" x="8" y="0" fontsize="11" shadow="true"
			global_color="false" color="200 200 200 220" hardtext="0" />

		<ctrl style="text_button_16" id="btn_fill0" posparent="btn_undo" posref="BL TL" x="0" y="-6"
			onclick_l="zp_fill" params_l="0" hardtext="Fill" />
		<ctrl style="text_button_16" id="btn_fill1" posparent="btn_fill0" posref="MR ML" x="4" y="0"
			onclick_l="zp_fill" params_l="1" hardtext="F1" />
		<ctrl style="text_button_16" id="btn_fill2" posparent="btn_fill1" posref="MR ML" x="4" y="0"
			onclick_l="zp_fill" params_l="2" hardtext="F2" />
		<ctrl style="text_button_16" id="btn_fill3" posparent="btn_fill2" posref="MR ML" x="4" y="0"
			onclick_l="zp_fill" params_l="3" hardtext="F3" />

		<!-- Save: frozen without CLI save on legacy; always on in interactive modal flow -->
		<ctrl style="text_button_16" id="btn_save" posparent="btn_fill0" posref="BL TL" x="0" y="-12"
			onclick_l="zp_save" params_l="" hardtext="Save" />
		<view type="text" id="hint" posparent="btn_save" posref="BL TL" x="0" y="-8" fontsize="10" shadow="true"
			global_color="false" color="255 255 255 140" hardtext="F10 hide  ESC quit" />

	</group>
</group>
<tree node="painter"></tree>

<!-- ===================================================================== -->
<!-- Save modal (interactive flow only; M3a)                               -->
<!-- ===================================================================== -->
<!-- Minimal edit-box chrome (same bevel pieces as the GUI sample). -->
<group type="modal" id="save_dialog" exit_click_out="false" w="360" h="200" options="skin_modal"
	mouse_pos="false" posref="MM MM" x="0" y="0" active="false">
	<group id="content" x="0" y="0" posref="TL TL" sizeref="wh" w="0" h="0">
		<view type="text" id="title" posref="TM TM" x="0" y="-14" color="255 255 255 255" fontsize="14"
			shadow="true" global_color="false" hardtext="Save painted zone" />
		<view type="text" id="status" posparent="title" posref="BM TM" x="0" y="-6" color="255 200 120 220"
			fontsize="11" shadow="true" global_color="false" hardtext="" />

		<view type="text" id="copy_lbl" posref="TL TL" x="16" y="-48" color="180 200 220 255" fontsize="11"
			shadow="true" global_color="false" hardtext="Copy as:" />
		<!-- Simple single-line edit box for the copy filename -->
		<group type="edit_box" id="copy_name" posparent="copy_lbl" posref="BL TL" x="0" y="-6" w="320" h="20"
			prompt="" max_num_chars="200" entry_type="text"
			enter_loose_focus="false" enter_recover_focus="true" reset_focus_on_hide="true"
			want_return="false" clear_on_escape="false">
			<view type="bitmap" id="bg" scale="true" sizeref="hw" texture="w_box_blank.tga" inherit_gc_alpha="true" />
			<view id="edit_text" type="text" x="2" y="2" posref="BL BL" multi_line="false"
				fontsize="12" color="255 255 255 255" shadow="true" hardtext="" global_color="false" />
		</group>

		<!-- M5c: update OLE embedded thumbnail (default on) -->
		<ctrl style="text_button_toggle" id="update_thumb" posparent="copy_name" posref="BL TL" x="0" y="-10"
			pushed="true" onclick_l="zp_save_thumb_toggle" params_l="" hardtext="Update thumbnail" />

		<ctrl style="text_button_16" id="btn_overwrite" posref="BL BL" x="16" y="16"
			onclick_l="zp_save_overwrite" params_l="" hardtext="Overwrite" />
		<ctrl style="text_button_16" id="btn_copy" posparent="btn_overwrite" posref="MR ML" x="8" y="0"
			onclick_l="zp_save_copy" params_l="" hardtext="Save copy" />
		<ctrl style="text_button_16" id="btn_cancel" posparent="btn_copy" posref="MR ML" x="8" y="0"
			onclick_l="zp_save_cancel" params_l="" hardtext="Cancel" />
	</group>
</group>

</interface_config>
