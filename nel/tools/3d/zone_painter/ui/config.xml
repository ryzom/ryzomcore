<interface_config>

<!-- Master group must match main.xml root id (ui:zp). A leftover "sample" root
     created a second active master group; setTopWindow walks every active MG and
     warned "window ui:zp:… do not exist in a priority list" for every window. -->
<root id="zp" x="0" y="0" w="800" h="600" active="true" />

<define id="case_normal" value="0" />
<define id="case_lower" value="1" />
<define id="case_upper" value="2" />
<define id="case_first_string_letter_up" value="3" />
<define id="case_first_sentence_letter_up" value="4" />
<define id="case_first_word_letter_up" value="5" />

<!-- Header color entries referenced by the container windows -->
<variable entry="UI:SAVE:WIN:COLORS:SAMPLE" type="rgba" value="200 216 230 255" />

<!-- Global interface color and alphas (fresh database leaves default to 0) -->
<variable entry="UI:SAVE:COLOR:R" type="sint32" value="255" />
<variable entry="UI:SAVE:COLOR:G" type="sint32" value="255" />
<variable entry="UI:SAVE:COLOR:B" type="sint32" value="255" />
