<variable entry="UI:SAVE:ALPHA_ROLLOVER_SPEED" type="sint32" value="0" />
<variable entry="UI:SAVE:DOUBLE_CLICK_SPEED" type="sint32" value="400" />
<variable entry="UI:SAVE:KEY_REPEAT_SPEED" type="sint32" value="500" />
<variable entry="UI:VARIABLES:ALPHA_BG" type="sint32" value="255" />
