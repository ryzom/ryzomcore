<interface_config>

<!-- Widget styles and templates shared by the showcase windows (legacy "w_" skin) -->

<style style="text_button_16" type="text_button" button_type="push_button"
	tx_normal="w_text_button_normal" tx_pushed="w_text_button_pushed" tx_over="w_text_button_over"
	global_color_normal="false" global_color_over="false" global_color_pushed="false"
	text_y="0" fontsize="12" shadow="true" case_mode="%case_upper" wmargin="8"
	text_color_normal="255 255 255 128" text_color_pushed="255 255 255 255" text_color_over="255 255 255 255" />

<style style="button_ok" type="text_button" id="ok" button_type="push_button"
	tx_normal="w_text_button_normal" tx_pushed="w_text_button_pushed" tx_over="w_text_button_over"
	global_color_normal="false" global_color_over="false" global_color_pushed="false"
	text_y="0" fontsize="12" shadow="true" case_mode="%case_upper" wmargin="8" />

<style style="tab_button" type="tab_button" button_type="radio_button" x="-2" posref="TR TL"
	tx_normal="w_tab_normal" tx_pushed="w_tab_pushed" tx_over="w_tab_over"
	global_color_normal="false" global_color_over="false" global_color_pushed="false"
	text_y="0" fontsize="12" shadow="true" case_mode="%case_upper" wmargin="8"
	text_color_normal="255 255 255 128" text_color_pushed="255 255 255 255" text_color_over="255 255 255 255" />

<!-- Beveled box decoration (w_box_* set) -->
<template name="box_widget" posref="TL TL" x="0" y="0" w="64" h="16" id="" posparent="parent" sizeref="" keep="true" render_layer="0">
	<group id="#id" posparent="#posparent" posref="#posref" w="#w" h="#h" x="#x" y="#y" sizeref="#sizeref">
		<group id="bg" sizeref="hw" h="0" w="0" />
		<view type="bitmap" render_layer="#render_layer" id="back" scale="true" posparent="bg" posref="MM MM" sizeref="hw" h="-8" w="-8" texture="w_box_blank.tga" inherit_gc_alpha="true" />
		<view type="bitmap" render_layer="#render_layer" id="bgb" scale="true" sizeref="hw" h="0" w="0" texture="w_box_blank.tga" inherit_gc_alpha="true" />
		<view type="bitmap" render_layer="#render_layer" id="tlb" texture="w_box_top_left.tga" posref="TL TL" inherit_gc_alpha="true" />
		<view type="bitmap" render_layer="#render_layer" id="trb" texture="w_box_top_right.tga" posref="TR TR" inherit_gc_alpha="true" />
		<view type="bitmap" render_layer="#render_layer" id="brb" texture="w_box_bot_right.tga" posref="BR BR" inherit_gc_alpha="true" />
		<view type="bitmap" render_layer="#render_layer" id="blb" texture="w_box_bot_left.tga" posref="BL BL" inherit_gc_alpha="true" />
		<view type="bitmap" render_layer="#render_layer" id="tb" texture="w_box_top.tga" posref="TM TM" scale="true" sizeref="w" w="-8" h="4" inherit_gc_alpha="true" />
		<view type="bitmap" render_layer="#render_layer" id="bb" texture="w_box_bot.tga" posref="BM BM" scale="true" sizeref="w" w="-8" h="4" inherit_gc_alpha="true" />
		<view type="bitmap" render_layer="#render_layer" id="lb" texture="w_box_left.tga" posref="ML ML" scale="true" sizeref="h" h="-8" w="4" inherit_gc_alpha="true" />
		<view type="bitmap" render_layer="#render_layer" id="rb" texture="w_box_right.tga" posref="MR MR" scale="true" sizeref="h" h="-8" w="4" inherit_gc_alpha="true" />
	</group>
</template>

<!-- Single/multi-line edit box in a beveled border (matches client widgets.xml) -->
<template name="edit_box_widget" active="true" posref="TL TL" text_x="0" text_y="2" text_ref="BL BL" child_resize_h="true" child_resize_hmargin="8" multi_line="false" x="0" y="0" w="0" h="0" sizeref="" id="eb" posparent="parent" onenter="" params="" reset_focus_on_hide="true" enter_loose_focus="true" prompt="" enter_recover_focus="true" max_num_bytes="0" max_num_chars="255" menu_r="ui:sample:editbox_menu" onchange="" onchange_params="" entry_type="text" keep="true" max_historic="10" fontsize="14" shadow="true" backup_father_container_pos="false" want_return="false" clear_on_escape="false" color="255 255 255 255" bg_texture="w_box_blank.tga" on_focus_lost="" on_focus_lost_params="" max_float_prec="5" negative_filter="" render_layer="0">
	<group id="#id" posparent="#posparent" posref="#posref" x="#x" y="#y" w="#w" h="#h" sizeref="#sizeref" child_resize_h="#child_resize_h" child_resize_hmargin="#child_resize_hmargin" active="#active">
		<group type="edit_box" sizeref="w" w="-8" id="eb" posref="TL TL" x="4" y="-4" child_resize_h="true" onenter="#onenter" params="#params" onchange="#onchange" onchange_params="#onchange_params" max_num_bytes="#max_num_bytes" max_num_chars="#max_num_chars" prompt="#prompt" enter_loose_focus="#enter_loose_focus" enter_recover_focus="#enter_recover_focus" entry_type="#entry_type" reset_focus_on_hide="#reset_focus_on_hide" menu_r="#menu_r" max_historic="#max_historic" want_return="#want_return" clear_on_escape="#clear_on_escape" backup_father_container_pos="#backup_father_container_pos" on_focus_lost="#on_focus_lost" on_focus_lost_params="#on_focus_lost_params" max_float_prec="#max_float_prec" negative_filter="#negative_filter" render_layer="#render_layer">
			<view type="bitmap" id="bg" scale="true" sizeref="hw" h="0" w="0" texture="#bg_texture" inherit_gc_alpha="true" render_layer="#render_layer" />
			<!-- BL BL; default text_y=2 lifts the baseline so glyphs without descenders sit in the optical center of the beveled box -->
			<view id="edit_text" type="text" x="#text_x" y="#text_y" posref="#text_ref" multi_line="#multi_line" multi_line_space="0" fontsize="#fontsize" color="#color" shadow="#shadow" hardtext="" global_color="false" render_layer="#render_layer" />
		</group>
		<view type="bitmap" id="tlb" texture="w_box_top_left.tga" posparent="eb" posref="TL BR" inherit_gc_alpha="true" render_layer="#render_layer" />
		<view type="bitmap" id="trb" texture="w_box_top_right.tga" posparent="eb" posref="TR BL" inherit_gc_alpha="true" render_layer="#render_layer" />
		<view type="bitmap" id="brb" texture="w_box_bot_right.tga" posparent="eb" posref="BR TL" inherit_gc_alpha="true" render_layer="#render_layer" />
		<view type="bitmap" id="blb" texture="w_box_bot_left.tga" posparent="eb" posref="BL TR" inherit_gc_alpha="true" render_layer="#render_layer" />
		<view type="bitmap" id="tb" texture="w_box_top.tga" posparent="eb" posref="TL BL" scale="true" sizeref="w" w="0" h="4" inherit_gc_alpha="true" render_layer="#render_layer" />
		<view type="bitmap" id="bb" texture="w_box_bot.tga" posparent="eb" posref="BL TL" scale="true" sizeref="w" w="0" h="4" inherit_gc_alpha="true" render_layer="#render_layer" />
		<view type="bitmap" id="lb" texture="w_box_left.tga" posparent="eb" posref="TL TR" scale="true" sizeref="h" h="0" w="4" inherit_gc_alpha="true" render_layer="#render_layer" />
		<view type="bitmap" id="rb" texture="w_box_right.tga" posparent="eb" posref="TR TL" scale="true" sizeref="h" h="0" w="4" inherit_gc_alpha="true" render_layer="#render_layer" />
	</group>
</template>

<!-- Combo box decoration + system parts (matches client widgets.xml) -->
<template name="combo_box_def1" keep="true" render_layer="0">
	<instance template="box_widget" render_layer="#render_layer" id="back" sizeref="wh" w="0" h="0" />
	<view type="bitmap" render_layer="#render_layer" id="arrow" posref="MR MR" x="-4" texture="w_arrow_down_2.tga" />
	<!-- x=2 left pad; y=1 optical vertical center in the 20px beveled box (ingame.ttf 14pt sits ~2px low at y=0) -->
	<view type="text" id="text" render_layer="#render_layer" posref="ML ML" x="2" y="1" fontsize="14" color="255 255 255 255" shadow="true" global_color="false" />
	<ctrl type="button" render_layer="#render_layer" button_type="push_button" id="select" sizeref="wh" w="0" h="0" col_over="255 255 255 90" tx_over="blank.tga" scale="true" />
</template>

<template name="menu_separator" keep="true">
	<group id="sep_gr" posref="BL BL" sizeref="w" w="0" h="4">
		<view type="bitmap" id="m" scale="true" w="0" h="0" sizeref="wh" texture="w_line_hor3.tga" />
	</group>
</template>

<template name="menu_separator_empty" keep="true">
	<group id="sep" posref="BL BL" w="4" h="4" x="-4"></group>
</template>

<!-- Labeled checkbox row (canonical reference for zone_painter zp_checkbox_row, M21b).
     Idiom: square toggle_button `box` with the w_ help/browser pair (w_slot_on /
     w_opacity_on). Transparent push_button `lbl` calls the same onclick so either
     the square or the caption toggles. Caption is a non-interactive text view over
     `lbl`. Sample instances pass a lua onclick that flips :box.pushed for both hits
     (box self-toggles first as toggle_button, so label-only needs the flip; for the
     box hit the lua re-flips — use onclick_box empty + onclick shared carefully).

     Sample wiring: box has empty onclick (toggle_button self-manages pushed);
     lbl uses lua to flip the sibling box so the caption is clickable too. -->
<template name="checkbox_row" keep="true" id="" label="" onclick_box="" params_box=""
	onclick_lbl="" params_lbl="" posparent="parent" posref="TL TL" x="0" y="0" pushed="false" w="200">
	<group id="#id" posparent="#posparent" posref="#posref" x="#x" y="#y" w="#w" h="18">
		<ctrl type="button" id="box" button_type="toggle_button" posref="ML ML" x="0" y="0"
			tx_normal="w_slot_on.tga" tx_pushed="w_opacity_on.tga" tx_over="w_slot_on.tga"
			color="255 255 255 255" col_pushed="255 255 255 255" col_over="255 255 255 0"
			global_color_normal="false" global_color_pushed="false" global_color_over="false"
			pushed="#pushed"
			onclick_l="#onclick_box" params_l="#params_box" />
		<ctrl type="button" id="lbl" button_type="push_button" posparent="box" posref="MR ML" x="2" y="0"
			w="160" h="16" scale="true"
			tx_normal="blank.tga" tx_pushed="blank.tga" tx_over="blank.tga"
			color="0 0 0 0" col_pushed="0 0 0 0" col_over="255 255 255 20"
			global_color_normal="false" global_color_pushed="false" global_color_over="false"
			onclick_l="#onclick_lbl" params_l="#params_lbl" />
		<view type="text" id="t" posparent="box" posref="MR ML" x="6" y="0" fontsize="12" shadow="true"
			global_color="false" color="255 255 255 220" hardtext="#label" />
	</group>
</template>

<!-- Base menu + the two menus the combo box machinery requires -->
<group type="menu" id="base_menu" mouse_pos="true" exit_click_b="true" space="1" fontsize="16" shadow="true"
	color="255 255 255 200" shadow_color="0 0 0 255" color_over="0 0 0 255" shadow_color_over="0 0 0 0"
	color_grayed="255 255 255 64" shadow_color_grayed="0 0 0 255" highlight_over="255 255 255 150" case_mode="%case_normal"></group>

<group type="menu" id="combo_box_select_menu" posref="BL TL" x="0" y="0" mouse_pos="false" space="2" shadow="false"
	color="255 255 255 128" shadow_color="0 0 0 255" color_over="255 255 255 255" shadow_color_over="0 0 0 255"
	color_grayed="0 0 0 255" shadow_color_grayed="155 155 155 255" fontsize="14" highlight_over="255 255 255 128"
	force_inside_screen="true"></group>

<group type="menu" id="combo_box_measure_menu" posref="BL TL" x="0" y="0" active="false" mouse_pos="false" space="2" shadow="false"
	color="255 255 255 128" shadow_color="0 0 0 255" color_over="255 255 255 255" shadow_color_over="0 0 0 255"
	color_grayed="0 0 0 255" shadow_color_grayed="155 155 155 255" fontsize="14" highlight_over="255 255 255 128"
	force_inside_screen="true" />

<!-- Right-click menu for edit boxes. The editbox_* handlers act on the edit
     box that opened the menu (CGroupEditBox::getMenuFather). Wired via
     menu_r on the edit_box_widget template default. -->
<group type="menu" id="editbox_menu" extends="ui:sample:base_menu">
	<action id="cut" name="Cut" handler="editbox_cut" params="" />
	<action id="copy" name="Copy" handler="editbox_copy" params="" />
	<action id="paste" name="Paste" handler="editbox_paste" params="" />
	<separator />
	<action id="select_all" name="Select all" handler="editbox_select_all" params="" />
</group>

</interface_config>
