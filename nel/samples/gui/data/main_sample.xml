			<combo_text name="Matis" />
			<combo_text name="Tryker" />
			<combo_text name="Zorai" />
		</group>
		<view type="text" id="l2" posparent="combo" posref="BL TL" x="0" y="-12" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" hardtext="select_number (menu entry sets it too):" />
		<!-- Client SNH layout: 16x16 slot, number with x=-1 y=-2 optical center, arrows at group TR/BR -->
		<group type="select_number" id="selnum" posparent="l2" posref="BL TL" x="0" y="-6" w="32" h="20" value="UI:TEMP:SELNUM" min="0" max="9" delta="1" loop="true">
			<view type="bitmap" id="slot_number" posref="ML ML" texture="w_slot_number.tga" global_color="false" />
			<view type="text" id="number" posparent="slot_number" posref="MM MM" x="-1" y="-2" fontsize="14" shadow="true" global_color="false" color="255 255 255 255" hardtext="0" />
