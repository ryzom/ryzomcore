<interface_config>

<!-- Mouse pointer (textures come from the interface atlas) -->
<group id="pointer_layer" posref="BL BL" x="0" y="0" sizeref="wh" w="0" h="0" active="true">
	<view type="generic_pointer" id="pointer" posref="BL BL" x="0" y="0" w="32" h="32"
		color="255 255 255 255"
		tx_default="curs_default.tga"
		tx_move_window="curs_default.tga"
		tx_colpick="curs_pick.tga"
		tx_pan="curs_pan.tga"
		tx_can_pan="curs_can_pan.tga" />
</group>

<proc id="proc_open_about">
	<action handler="enter_modal" params="group=ui:sample:about" />
</proc>

<proc id="proc_toggle">
	<action handler="set" params="target='ui:sample:@0:active'|value=not(getprop('ui:sample:@0:active'))" />
</proc>

<!-- ******************** -->
<!-- * Launcher window  * -->
<!-- ******************** -->

<group type="container" id="launcher" w="180" pop_min_w="180" pop_max_w="180" h="400" pop_min_h="400" pop_max_h="400"
	title="Showcase" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="false" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="8" y="1190">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<ctrl style="text_button_16" id="bt_views"   x="12" y="-12"  posref="TL TL" onclick_l="proc" params_l="proc_toggle|views"   hardtext="Views" />
		<ctrl style="text_button_16" id="bt_buttons" x="0"  y="-8" posparent="bt_views"   posref="BL TL" onclick_l="proc" params_l="proc_toggle|buttons" hardtext="Buttons" />
		<ctrl style="text_button_16" id="bt_sliders" x="0"  y="-8" posparent="bt_buttons" posref="BL TL" onclick_l="proc" params_l="proc_toggle|sliders" hardtext="Sliders + Bars" />
		<ctrl style="text_button_16" id="bt_edit"    x="0"  y="-8" posparent="bt_sliders" posref="BL TL" onclick_l="proc" params_l="proc_toggle|editors" hardtext="Edit Boxes" />
		<ctrl style="text_button_16" id="bt_lists"   x="0"  y="-8" posparent="bt_edit"    posref="BL TL" onclick_l="proc" params_l="proc_toggle|lists"   hardtext="List + Tree" />
		<ctrl style="text_button_16" id="bt_menus"   x="0"  y="-8" posparent="bt_lists"   posref="BL TL" onclick_l="proc" params_l="proc_toggle|menus"   hardtext="Menus + Combo" />
		<ctrl style="text_button_16" id="bt_tabs"    x="0"  y="-8" posparent="bt_menus"   posref="BL TL" onclick_l="proc" params_l="proc_toggle|tabs"    hardtext="Tabs" />
		<ctrl style="text_button_16" id="bt_colors"  x="0"  y="-8" posparent="bt_tabs"    posref="BL TL" onclick_l="proc" params_l="proc_toggle|colors"  hardtext="Color Picker" />
		<ctrl style="text_button_16" id="bt_rollout" x="0"  y="-8" posparent="bt_colors"  posref="BL TL" onclick_l="proc" params_l="proc_toggle|rollout" hardtext="Rollout List" />
		<ctrl style="text_button_16" id="bt_about"   x="0"  y="-8" posparent="bt_rollout" posref="BL TL" onclick_l="proc" params_l="proc_open_about" hardtext="About" />
		<ctrl style="text_button_16" id="bt_quit"    x="0"  y="-8" posparent="bt_about"   posref="BL TL" onclick_l="sample_quit" params_l="" hardtext="Quit" />
	</group>
</group>
<tree node="launcher"></tree>

<!-- ******************** -->
<!-- * Views (layer0)   * -->
<!-- ******************** -->

<group type="container" id="views" w="380" pop_min_w="380" pop_max_w="380" h="330" pop_min_h="330" pop_max_h="330"
	title="Views: text + bitmap + numbers" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="200" y="1190">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<view type="text" id="t1" posref="TL TL" x="12" y="-10" fontsize="14" shadow="true" global_color="false" color="255 255 255 255" hardtext="Plain text 14" />
		<view type="text" id="t2" posparent="t1" posref="BL TL" y="-4" fontsize="10" shadow="false" global_color="false" color="180 220 255 255" hardtext="colored small text without shadow" />
		<view type="text" id="t3" posparent="t2" posref="BL TL" y="-4" fontsize="10" shadow="true" case_mode="%case_upper" global_color="false" color="255 220 150 255" hardtext="upper case mode text" />
		<view type="text" id="t4" posparent="t3" posref="BL TL" y="-6" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" multi_line="true" multi_line_space="2" w="220" sizeref=""
			hardtext="A multi-line text view: line breaking happens on the available width, with a per-line spacing setting." />
		<view type="bitmap" id="b1" posref="TR TR" x="-14" y="-12" texture="w_slot_item.tga" global_color="false" />
		<view type="bitmap" id="b2" posparent="b1" posref="BL TL" y="-6" texture="w_slot_item.tga" scale="true" w="64" h="64" global_color="false" />
		<view type="bitmap" id="b3" posparent="b2" posref="BL TL" y="-6" texture="w_line_hor.tga" scale="true" w="96" h="4" global_color="false" />
		<view type="text" id="numlabel" posref="BL BL" x="12" y="42" fontsize="10" shadow="true" global_color="false" color="255 255 255 255" hardtext="text_number / digit views:" />
		<view type="text_number" id="num" posparent="numlabel" posref="BL TL" y="-6" value="UI:TEMP:SLIDERH" fontsize="12" shadow="true" global_color="false" color="150 255 150 255" />
		<view type="digit" id="dig" posparent="num" posref="MR ML" x="24" value="UI:TEMP:SLIDERH" numdigit="3" wspace="1" color="255 255 255 255" />
	</group>
</group>
<tree node="views"></tree>

<!-- ******************** -->
<!-- * Buttons (layer1) * -->
<!-- ******************** -->

<group type="container" id="buttons" options="layer1" w="300" pop_min_w="300" pop_max_w="300" h="240" pop_min_h="240" pop_max_h="240"
	title="Buttons" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="270" y="840">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="14" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<view type="text" id="l1" posref="TL TL" x="12" y="-10" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" hardtext="push / toggle / radio buttons:" />
		<ctrl type="button" id="push1" button_type="push_button" posparent="l1" posref="BL TL" x="0" y="-6"
			tx_normal="w_close_0.tga" tx_pushed="w_close_1.tga" tx_over="w_button_12_over.tga" global_color_normal="false" global_color_pushed="false" />
		<ctrl type="button" id="tog1" button_type="toggle_button" posparent="push1" posref="MR ML" x="10"
			tx_normal="w_sound_off.tga" tx_pushed="w_sound_on.tga" tx_over="w_button_14_over.tga" global_color_normal="false" global_color_pushed="false" />
		<ctrl type="button" id="tog2" button_type="toggle_button" posparent="tog1" posref="MR ML" x="10"
			tx_normal="w_button_filter_off.tga" tx_pushed="w_button_filter_on.tga" tx_over="" global_color_normal="false" global_color_pushed="false" />
		<ctrl type="button" id="rad1" button_type="radio_button" posparent="tog2" posref="MR ML" x="16" pushed="true"
			tx_normal="w_opacity_on.tga" tx_pushed="w_slot_on.tga" tx_over="w_slot_on.tga" color="255 255 255 255" col_pushed="255 255 255 255" col_over="255 255 255 0" />
		<ctrl type="button" id="rad2" button_type="radio_button" posparent="rad1" posref="MR ML" x="8"
			tx_normal="w_opacity_on.tga" tx_pushed="w_slot_on.tga" tx_over="w_slot_on.tga" color="255 255 255 255" col_pushed="255 255 255 255" col_over="255 255 255 0" />
		<ctrl type="button" id="rad3" button_type="radio_button" posparent="rad2" posref="MR ML" x="8"
			tx_normal="w_opacity_on.tga" tx_pushed="w_slot_on.tga" tx_over="w_slot_on.tga" color="255 255 255 255" col_pushed="255 255 255 255" col_over="255 255 255 0" />
		<view type="text" id="l2" posparent="push1" posref="BL TL" x="0" y="-12" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" hardtext="text buttons (w_text_button skin):" />
		<ctrl style="text_button_16" id="tb1" posparent="l2" posref="BL TL" x="0" y="-6" onclick_l="" params_l="" hardtext="Normal" />
		<ctrl style="text_button_16" id="tb2" posparent="tb1" posref="MR ML" x="8" onclick_l="" params_l="" hardtext="Another" />
		<view type="text" id="l3" posparent="tb1" posref="BL TL" x="0" y="-12" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" hardtext="arrow + scale buttons:" />
		<ctrl type="button" id="ar1" button_type="push_button" posparent="l3" posref="BL TL" x="0" y="-6"
			tx_normal="w_arrow_up_1.tga" tx_pushed="w_arrow_up_1.tga" tx_over="w_button_10_over.tga" global_color_normal="false" />
		<ctrl type="button" id="ar2" button_type="push_button" posparent="ar1" posref="MR ML" x="6"
			tx_normal="w_arrow_down_1.tga" tx_pushed="w_arrow_down_1.tga" tx_over="w_button_10_over.tga" global_color_normal="false" />
		<ctrl type="button" id="sc1" button_type="push_button" posparent="ar2" posref="MR ML" x="12"
			tx_normal="w_scale_more_3.tga" tx_pushed="w_scale_more_3.tga" tx_over="w_button_08_over.tga" global_color_normal="false" />
		<ctrl type="button" id="sc2" button_type="push_button" posparent="sc1" posref="MR ML" x="6"
			tx_normal="w_scale_less_3.tga" tx_pushed="w_scale_less_3.tga" tx_over="w_button_08_over.tga" global_color_normal="false" />
	</group>
</group>
<tree node="buttons"></tree>

<!-- *************************** -->
<!-- * Sliders + bars (layer0) * -->
<!-- *************************** -->

<group type="container" id="sliders" w="400" pop_min_w="400" pop_max_w="400" h="260" pop_min_h="260" pop_max_h="260"
	title="Sliders, gauges and links" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="600" y="1190">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<view type="text" id="l1" posref="TL TL" x="12" y="-10" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" hardtext="slider drives the gauges:" />
		<ctrl type="scroll" id="sh" posparent="l1" posref="BL TL" x="0" y="-8" w="160" h="8" vertical="false" align="L" min="0" max="255" value="UI:TEMP:SLIDERH" tracksize="24"
			tx_topright="w_scroll_r.tga" tx_middle="w_scroll_l123_m.tga" tx_bottomleft="w_scroll_l.tga" />
		<view type="text_number" id="shv" posparent="sh" posref="MR ML" x="12" value="UI:TEMP:SLIDERH" fontsize="10" shadow="true" global_color="false" color="150 255 150 255" />
		<view type="bar" id="bar1" posparent="sh" posref="BL TL" x="0" y="-14" value="UI:TEMP:SLIDERH" range="255" color="255 255 255 255" global_color="false" />
		<view type="bar3" id="bar3" posparent="bar1" posref="BL TL" x="0" y="-10"
			value1="UI:TEMP:SLIDERH" range1="255" color1="255 80 80 255"
			value2="UI:TEMP:SLIDERV" range2="255" color2="80 255 80 255"
			value3="UI:TEMP:SELNUM" range3="10" color3="80 80 255 255" global_color="false" />
		<view type="text_quantity" id="qty" posparent="bar3" posref="BL TL" x="0" y="-12" value="UI:TEMP:QTY" valuemax="UI:TEMP:QTYMAX" fontsize="10" shadow="true" global_color="false" color="255 255 255 255" />
		<view type="text" id="l2" posparent="qty" posref="BL TL" x="0" y="-10" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" hardtext="link warning above 200:" />
		<view type="bitmap" id="warn" posparent="l2" posref="MR ML" x="10" texture="w_warning.tga" global_color="false" active="false" />
		<view type="text" id="l3" posref="TR TR" x="-16" y="-10" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" hardtext="vertical:" />
		<ctrl type="scroll" id="sv" posparent="l3" posref="BM TM" y="-6" w="8" h="120" vertical="true" align="B" min="0" max="255" value="UI:TEMP:SLIDERV" tracksize="24"
			tx_topright="w_scroll_l0_t.tga" tx_middle="w_scroll_l0_m.tga" tx_bottomleft="w_scroll_l0_b.tga" />
		<view type="text_number" id="svv" posparent="sv" posref="BM TM" y="-6" value="UI:TEMP:SLIDERV" fontsize="10" shadow="true" global_color="false" color="150 255 150 255" />
	</group>
</group>
<tree node="sliders"></tree>
<!-- no gt() in the base expression set: >200 becomes not(not(max(x-200, 0))) -->
<link expr="not(not(max(sub(@UI:TEMP:SLIDERH, 200), 0)))" target="ui:sample:sliders:content:warn:active" />

<!-- ********************** -->
<!-- * Edit boxes (layer0) * -->
<!-- ********************** -->

<group type="container" id="editors" w="360" pop_min_w="360" pop_max_w="360" h="300" pop_min_h="300" pop_max_h="300"
	title="Edit boxes and scroll text" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="600" y="840">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<view type="text" id="l1" posref="TL TL" x="12" y="-8" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" hardtext="single line (click, then type):" />
		<instance template="edit_box_widget" id="eb_text" posparent="l1" posref="BL TL" x="0" y="-4" w="240" prompt="&gt; " entry_type="text" max_num_chars="64" />
		<view type="text" id="l2" posparent="eb_text" posref="BL TL" x="0" y="-8" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" hardtext="integer entry:" />
		<instance template="edit_box_widget" id="eb_int" posparent="l2" posref="BL TL" x="0" y="-4" w="120" entry_type="positive_integer" max_num_chars="6" />
		<view type="text" id="l3" posparent="eb_int" posref="BL TL" x="0" y="-8" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" hardtext="scroll text (mouse wheel):" />
		<group type="scroll_text" id="st" posparent="l3" posref="BL TL" x="0" y="-4" w="320" h="120" min_height="120" max_height="120">
			<group type="list" id="text_list" shadow="true" fontsize="10" color="255 255 255 255" space="3" global_color="false" posref="TL TL" x="8" y="-8" sizeref="hw" w="-24" h="-16"
				hardtext="This is a scroll_text group. It combines a text list with the w_ scrollbar so long content can be scrolled with the mouse wheel or by dragging the thumb. The quick brown fox jumps over the lazy dog. Portez ce vieux whisky au juge blond qui fume. Voix ambigue d'un coeur qui au zephyr prefere les jattes de kiwis. Sphinx of black quartz, judge my vow. Pack my box with five dozen liquor jugs. The five boxing wizards jump quickly. How vexingly quick daft zebras jump. Jived fox nymph grabs quick waltz. Glib jocks quiz nymph to vex dwarf." />
			<ctrl type="scroll" id="scroll_bar" align="T" posref="TR TR" x="-4" y="-4" w="8" sizeref="h" h="-8"
				tx_topright="w_scroll_l0_t.tga" tx_middle="w_scroll_l0_m.tga" tx_bottomleft="w_scroll_l0_b.tga" />
		</group>
	</group>
</group>
<tree node="editors"></tree>

<!-- *********************** -->
<!-- * List + tree (layer2) * -->
<!-- *********************** -->

<group type="container" id="lists" options="layer2" w="300" pop_min_w="300" pop_max_w="300" h="280" pop_min_h="280" pop_max_h="280"
	title="List and tree" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="960" y="1190">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="14" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<view type="text" id="l1" posref="TL TL" x="12" y="-8" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" multi_line="true" w="260" sizeref=""
			hardtext="group_list is the runtime-filled stack used by chat and the scroll text window; group_tree below (arbo_* fold arrows):" />
		<group type="tree" id="tree" posparent="l1" posref="BL TL" x="8" y="-8" col_over="255 255 255 48" col_select="255 255 255 80" fontsize="10">
			<node id="root" name="Atys" opened="true" fontsize="10">
				<node id="forest" name="Forest" opened="true">
					<node id="yubo" name="Yubo" />
					<node id="gingo" name="Gingo" />
				</node>
				<node id="desert" name="Desert" opened="false">
					<node id="mektoub" name="Mektoub" />
				</node>
				<node id="lakes" name="Lakes" />
			</node>
		</group>
	</group>
</group>
<tree node="lists"></tree>

<!-- **************************** -->
<!-- * Menus + combo (layer1)   * -->
<!-- **************************** -->

<group type="menu" id="sample_menu" extends="ui:sample:base_menu">
	<action id="one" name="First entry" handler="set" params="dblink=UI:TEMP:SELNUM|value=1" />
	<action id="two" name="Second entry" handler="set" params="dblink=UI:TEMP:SELNUM|value=2" />
	<separator />
	<action id="check" name="Checkable" checkable="true" checked="true" handler="" params="" />
	<action id="gray" name="Grayed entry" grayed="true" handler="" params="" />
	<action id="sub" name="Submenu" handler="" params="">
		<action id="suba" name="Nested A" handler="set" params="dblink=UI:TEMP:SELNUM|value=8" />
		<action id="subb" name="Nested B" handler="set" params="dblink=UI:TEMP:SELNUM|value=9" />
	</action>
</group>

<group type="container" id="menus" options="layer1" w="340" pop_min_w="340" pop_max_w="340" h="220" pop_min_h="220" pop_max_h="220"
	title="Menus, combo, select number" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="960" y="880">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="14" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0" group_onclick_r="active_menu" group_params_r="menu=ui:sample:sample_menu">
		<ctrl style="text_button_16" id="bt_menu" posref="TL TL" x="12" y="-10" onclick_l="active_menu" params_l="menu=ui:sample:sample_menu" hardtext="Open Menu" />
		<view type="text" id="l0" posparent="bt_menu" posref="MR ML" x="8" fontsize="10" shadow="true" global_color="false" color="255 255 255 160" hardtext="(or right-click here)" />
		<view type="text" id="l1" posparent="bt_menu" posref="BL TL" x="0" y="-12" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" hardtext="combo box:" />
		<group type="combo_box" id="combo" posparent="l1" posref="BL TL" x="0" y="-4" w="160" h="20" value="UI:TEMP:COMBO">
			<instance template="combo_box_def1" />
			<combo_text name="Fyros" />
			<combo_text name="Matis" />
			<combo_text name="Tryker" />
			<combo_text name="Zorai" />
		</group>
		<view type="text" id="l2" posparent="combo" posref="BL TL" x="0" y="-10" fontsize="10" shadow="true" global_color="false" color="255 255 255 200" hardtext="select_number (menu entry sets it too):" />
		<group type="select_number" id="selnum" posparent="l2" posref="BL TL" x="0" y="-4" w="60" h="24" value="UI:TEMP:SELNUM" min="0" max="9" delta="1" loop="true">
			<view type="bitmap" id="slot_number" posref="ML ML" x="0" y="0" texture="w_slot_number.tga" global_color="false" />
			<view type="text" id="number" posparent="slot_number" posref="MM MM" fontsize="12" shadow="true" global_color="false" color="255 255 255 255" />
			<ctrl type="button" id="arrow_up" button_type="push_button" posparent="slot_number" posref="TR TL" x="4" y="0"
				tx_normal="w_arrow_up_2.tga" tx_pushed="w_arrow_up_2.tga" tx_over="w_button_10_over.tga" global_color_normal="false" />
			<ctrl type="button" id="arrow_down" button_type="push_button" posparent="slot_number" posref="BR BL" x="4" y="0"
				tx_normal="w_arrow_down_2.tga" tx_pushed="w_arrow_down_2.tga" tx_over="w_button_10_over.tga" global_color_normal="false" />
		</group>
