<!-- * Edit boxes (layer0) * -->
<!-- ********************** -->

<group type="container" id="editors" w="380" pop_min_w="380" pop_max_w="380" h="298" pop_min_h="298" pop_max_h="298"
	title="Edit boxes and scroll text" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="588" y="508">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<view type="text" id="l1" posref="TL TL" x="12" y="-8" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" hardtext="single line (click, then type):" />
		<instance template="edit_box_widget" id="eb_text" posparent="l1" posref="BL TL" x="0" y="-4" w="280" prompt="&gt; " entry_type="text" max_num_chars="64" />
		<view type="text" id="l2" posparent="eb_text" posref="BL TL" x="0" y="-8" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" hardtext="integer entry:" />
		<instance template="edit_box_widget" id="eb_int" posparent="l2" posref="BL TL" x="0" y="-4" w="100" entry_type="positive_integer" max_num_chars="6" />
		<view type="text" id="l3" posparent="eb_int" posref="BL TL" x="0" y="-8" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" hardtext="scroll text (mouse wheel):" />
		<group type="scroll_text" id="st" posparent="l3" posref="BL TL" x="0" y="-4" w="348" h="130" min_height="130" max_height="130">
			<group type="list" id="text_list" shadow="true" fontsize="14" color="255 255 255 255" space="3" global_color="false" posref="TL TL" x="8" y="-6" sizeref="hw" w="-24" h="-12"
				hardtext="This is a scroll_text group. It combines a text list with the w_ scrollbar so long content can be scrolled with the mouse wheel or by dragging the thumb. The quick brown fox jumps over the lazy dog. Portez ce vieux whisky au juge blond qui fume. Voix ambigue d'un coeur qui au zephyr prefere les jattes de kiwis. Sphinx of black quartz, judge my vow. Pack my box with five dozen liquor jugs. The five boxing wizards jump quickly. How vexingly quick daft zebras jump. Jived fox nymph grabs quick waltz. Glib jocks quiz nymph to vex dwarf." />
			<ctrl type="scroll" id="scroll_bar" align="T" posref="TR TR" x="-4" y="-4" w="8" sizeref="h" h="-8"
				tx_topright="w_scroll_l0_t.tga" tx_middle="w_scroll_l0_m.tga" tx_bottomleft="w_scroll_l0_b.tga" />
		</group>
	</group>
</group>
<tree node="editors"></tree>

