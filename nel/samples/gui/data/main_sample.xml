<interface_config>

<!-- Mouse pointer (textures come from the interface atlas) -->
<group id="pointer_layer" posref="BL BL" x="0" y="0" sizeref="wh" w="0" h="0" active="true">
	<view type="generic_pointer" id="pointer" posref="BL BL" x="0" y="0" w="32" h="32"
		color="255 255 255 255"
		tx_default="curs_default.tga"
		tx_move_window="curs_default.tga"
		tx_colpick="curs_pick.tga"
		tx_pan="curs_pan.tga"
		tx_can_pan="curs_can_pan.tga" />
</group>

<proc id="proc_open_about">
	<action handler="enter_modal" params="group=ui:sample:about" />
</proc>

<proc id="proc_toggle">
	<action handler="set" params="target='ui:sample:@0:active'|value=not(getprop('ui:sample:@0:active'))" />
</proc>

<!-- ******************** -->
<!-- * Launcher window  * -->
<!-- ******************** -->

<group type="container" id="launcher" w="176" pop_min_w="176" pop_max_w="176" h="284" pop_min_h="284" pop_max_h="284"
	title="Showcase" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="false" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="8" y="712">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<!-- 12px left inset, 10px top; 6px vertical gap keeps the 16px buttons evenly paced -->
		<ctrl style="text_button_16" id="bt_views"   x="12" y="-10" posref="TL TL" onclick_l="proc" params_l="proc_toggle|views"   hardtext="Views" />
		<ctrl style="text_button_16" id="bt_buttons" x="0"  y="-6" posparent="bt_views"   posref="BL TL" onclick_l="proc" params_l="proc_toggle|buttons" hardtext="Buttons" />
		<ctrl style="text_button_16" id="bt_sliders" x="0"  y="-6" posparent="bt_buttons" posref="BL TL" onclick_l="proc" params_l="proc_toggle|sliders" hardtext="Sliders + Bars" />
		<ctrl style="text_button_16" id="bt_edit"    x="0"  y="-6" posparent="bt_sliders" posref="BL TL" onclick_l="proc" params_l="proc_toggle|editors" hardtext="Edit Boxes" />
		<ctrl style="text_button_16" id="bt_lists"   x="0"  y="-6" posparent="bt_edit"    posref="BL TL" onclick_l="proc" params_l="proc_toggle|lists"   hardtext="List + Tree" />
		<ctrl style="text_button_16" id="bt_menus"   x="0"  y="-6" posparent="bt_lists"   posref="BL TL" onclick_l="proc" params_l="proc_toggle|menus"   hardtext="Menus + Combo" />
		<ctrl style="text_button_16" id="bt_tabs"    x="0"  y="-6" posparent="bt_menus"   posref="BL TL" onclick_l="proc" params_l="proc_toggle|tabs"    hardtext="Tabs" />
		<ctrl style="text_button_16" id="bt_colors"  x="0"  y="-6" posparent="bt_tabs"    posref="BL TL" onclick_l="proc" params_l="proc_toggle|colors"  hardtext="Color Picker" />
		<ctrl style="text_button_16" id="bt_rollout" x="0"  y="-6" posparent="bt_colors"  posref="BL TL" onclick_l="proc" params_l="proc_toggle|rollout" hardtext="Rollout List" />
		<ctrl style="text_button_16" id="bt_about"   x="0"  y="-6" posparent="bt_rollout" posref="BL TL" onclick_l="proc" params_l="proc_open_about" hardtext="About" />
		<ctrl style="text_button_16" id="bt_quit"    x="0"  y="-6" posparent="bt_about"   posref="BL TL" onclick_l="sample_quit" params_l="" hardtext="Quit" />
	</group>
</group>
<tree node="launcher"></tree>

<!-- ******************** -->
<!-- * Views (layer0)   * -->
<!-- ******************** -->

<group type="container" id="views" w="380" pop_min_w="380" pop_max_w="380" h="210" pop_min_h="210" pop_max_h="210"
	title="Views: text + bitmap + numbers" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="196" y="712">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<view type="text" id="t1" posref="TL TL" x="12" y="-10" fontsize="18" shadow="true" global_color="false" color="255 255 255 255" hardtext="Plain text 18" />
		<view type="text" id="t2" posparent="t1" posref="BL TL" y="-4" fontsize="14" shadow="false" global_color="false" color="180 220 255 255" hardtext="colored small text without shadow" />
		<view type="text" id="t3" posparent="t2" posref="BL TL" y="-4" fontsize="14" shadow="true" case_mode="%case_upper" global_color="false" color="255 220 150 255" hardtext="upper case mode text" />
		<!-- Width tuned for even three-line wrap (no orphan last word) -->
		<view type="text" id="t4" posparent="t3" posref="BL TL" y="-8" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" multi_line="true" multi_line_space="2" line_maxw="250" sizeref=""
			hardtext="A multi-line text view: line breaking uses the available width and a per-line spacing value." />
		<view type="bitmap" id="b1" posref="TR TR" x="-14" y="-12" texture="w_slot_item.tga" global_color="false" />
		<view type="bitmap" id="b2" posparent="b1" posref="BL TL" y="-6" texture="w_slot_item.tga" scale="true" w="64" h="64" global_color="false" />
		<view type="bitmap" id="b3" posparent="b2" posref="BL TL" y="-6" texture="w_line_hor.tga" scale="true" w="96" h="4" global_color="false" />
		<view type="text" id="numlabel" posref="BL BL" x="12" y="36" fontsize="14" shadow="true" global_color="false" color="255 255 255 255" hardtext="text_number / digit views:" />
		<view type="text_number" id="num" posparent="numlabel" posref="BL TL" y="-6" value="UI:TEMP:SLIDERH" fontsize="16" shadow="true" global_color="false" color="150 255 150 255" />
		<view type="digit" id="dig" posparent="num" posref="MR ML" x="16" y="0" value="UI:TEMP:SLIDERH" numdigit="3" wspace="1" color="255 255 255 255" />
	</group>
</group>
<tree node="views"></tree>

<!-- ******************** -->
<!-- * Buttons (layer1) * -->
<!-- ******************** -->

<group type="container" id="buttons" w="300" pop_min_w="300" pop_max_w="300" h="152" pop_min_h="152" pop_max_h="152"
	title="Buttons" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="272" y="494">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="14" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<view type="text" id="l1" posref="TL TL" x="12" y="-8" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" hardtext="push / toggle / radio buttons:" />
		<ctrl type="button" id="push1" button_type="push_button" posparent="l1" posref="BL TL" x="0" y="-6"
			tx_normal="w_close_0.tga" tx_pushed="w_close_1.tga" tx_over="w_button_12_over.tga" global_color_normal="false" global_color_pushed="false" />
		<ctrl type="button" id="tog1" button_type="toggle_button" posparent="push1" posref="MR ML" x="10"
			tx_normal="w_sound_off.tga" tx_pushed="w_sound_on.tga" tx_over="w_button_14_over.tga" global_color_normal="false" global_color_pushed="false" />
		<ctrl type="button" id="tog2" button_type="toggle_button" posparent="tog1" posref="MR ML" x="10"
			tx_normal="w_button_filter_off.tga" tx_pushed="w_button_filter_on.tga" tx_over="" global_color_normal="false" global_color_pushed="false" />
		<ctrl type="button" id="rad1" button_type="radio_button" posparent="tog2" posref="MR ML" x="16" pushed="true"
			tx_normal="w_opacity_on.tga" tx_pushed="w_slot_on.tga" tx_over="w_slot_on.tga" color="255 255 255 255" col_pushed="255 255 255 255" col_over="255 255 255 0" />
		<ctrl type="button" id="rad2" button_type="radio_button" posparent="rad1" posref="MR ML" x="8"
			tx_normal="w_opacity_on.tga" tx_pushed="w_slot_on.tga" tx_over="w_slot_on.tga" color="255 255 255 255" col_pushed="255 255 255 255" col_over="255 255 255 0" />
		<ctrl type="button" id="rad3" button_type="radio_button" posparent="rad2" posref="MR ML" x="8"
			tx_normal="w_opacity_on.tga" tx_pushed="w_slot_on.tga" tx_over="w_slot_on.tga" color="255 255 255 255" col_pushed="255 255 255 255" col_over="255 255 255 0" />
		<view type="text" id="l2" posparent="push1" posref="BL TL" x="0" y="-10" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" hardtext="text buttons (w_text_button skin):" />
		<ctrl style="text_button_16" id="tb1" posparent="l2" posref="BL TL" x="0" y="-6" onclick_l="" params_l="" hardtext="Normal" />
		<ctrl style="text_button_16" id="tb2" posparent="tb1" posref="MR ML" x="8" onclick_l="" params_l="" hardtext="Another" />
		<view type="text" id="l3" posparent="tb1" posref="BL TL" x="0" y="-10" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" hardtext="arrow + scale buttons:" />
		<ctrl type="button" id="ar1" button_type="push_button" posparent="l3" posref="BL TL" x="0" y="-6"
			tx_normal="w_arrow_up_1.tga" tx_pushed="w_arrow_up_1.tga" tx_over="w_button_10_over.tga" global_color_normal="false" />
		<ctrl type="button" id="ar2" button_type="push_button" posparent="ar1" posref="MR ML" x="6"
			tx_normal="w_arrow_down_1.tga" tx_pushed="w_arrow_down_1.tga" tx_over="w_button_10_over.tga" global_color_normal="false" />
		<ctrl type="button" id="sc1" button_type="push_button" posparent="ar2" posref="MR ML" x="12"
			tx_normal="w_scale_more_3.tga" tx_pushed="w_scale_more_3.tga" tx_over="w_button_08_over.tga" global_color_normal="false" />
		<ctrl type="button" id="sc2" button_type="push_button" posparent="sc1" posref="MR ML" x="6"
			tx_normal="w_scale_less_3.tga" tx_pushed="w_scale_less_3.tga" tx_over="w_button_08_over.tga" global_color_normal="false" />
	</group>
</group>
<tree node="buttons"></tree>

<!-- *************************** -->
<!-- * Sliders + bars (layer0) * -->
<!-- *************************** -->

<group type="container" id="sliders" w="400" pop_min_w="400" pop_max_w="400" h="200" pop_min_h="200" pop_max_h="200"
	title="Sliders, gauges and links" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="true" x="588" y="712">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<!-- Left column: horizontal slider + gauges; right column: vertical slider -->
		<view type="text" id="l1" posref="TL TL" x="12" y="-10" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" hardtext="slider drives the gauges:" />
		<ctrl type="scroll" id="sh" posparent="l1" posref="BL TL" x="0" y="-10" w="200" h="8" vertical="false" align="L" min="0" max="255" value="UI:TEMP:SLIDERH" tracksize="24"
			tx_topright="w_scroll_r.tga" tx_middle="w_scroll_m.tga" tx_bottomleft="w_scroll_l.tga" />
		<view type="text_number" id="shv" posparent="sh" posref="MR ML" x="10" y="0" value="UI:TEMP:SLIDERH" fontsize="16" shadow="true" global_color="false" color="150 255 150 255" />
		<view type="bar" id="bar1" posparent="sh" posref="BL TL" x="0" y="-14" value="UI:TEMP:SLIDERH" range="255" color="255 255 255 255" global_color="false" />
		<view type="bar3" id="bar3" posparent="bar1" posref="BL TL" x="0" y="-10"
			value1="UI:TEMP:SLIDERH" range1="255" color1="255 80 80 255"
			value2="UI:TEMP:SLIDERV" range2="255" color2="80 255 80 255"
			value3="UI:TEMP:SELNUM" range3="10" color3="80 80 255 255" global_color="false" />
		<view type="text_quantity" id="qty" posparent="bar3" posref="BL TL" x="0" y="-12" value="UI:TEMP:QTY" valuemax="UI:TEMP:QTYMAX" fontsize="14" shadow="true" global_color="false" color="255 255 255 255" />
		<view type="text" id="l2" posparent="qty" posref="BL TL" x="0" y="-10" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" hardtext="link warning above 200:" />
		<view type="bitmap" id="warn" posparent="l2" posref="MR ML" x="8" y="0" texture="w_warning.tga" global_color="false" active="false" />
		<!-- Vertical slider inset ~40px from the right border -->
		<view type="text" id="l3" posref="TR TR" x="-40" y="-10" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" hardtext="vertical:" />
		<ctrl type="scroll" id="sv" posparent="l3" posref="BM TM" y="-6" w="8" h="110" vertical="true" align="B" min="0" max="255" value="UI:TEMP:SLIDERV" tracksize="24"
			tx_topright="w_scroll_l0_t.tga" tx_middle="w_scroll_l0_m.tga" tx_bottomleft="w_scroll_l0_b.tga" />
		<view type="text_number" id="svv" posparent="sv" posref="BM TM" y="-6" value="UI:TEMP:SLIDERV" fontsize="16" shadow="true" global_color="false" color="150 255 150 255" />
	</group>
</group>
<tree node="sliders"></tree>
<!-- no gt() in the base expression set: >200 becomes not(not(max(x-200, 0))) -->
<link expr="not(not(max(sub(@UI:TEMP:SLIDERH, 200), 0)))" target="ui:sample:sliders:content:warn:active" />

