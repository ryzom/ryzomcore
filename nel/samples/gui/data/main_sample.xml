	<action id="two" name="Second entry" handler="set" params="dblink=UI:TEMP:SELNUM|value=2" />
	<separator />
	<action id="check" name="Checkable" checkable="true" checked="true" handler="" params="" />
	<action id="gray" name="Grayed entry" grayed="true" handler="" params="" />
	<action id="sub" name="Submenu" handler="" params="">
