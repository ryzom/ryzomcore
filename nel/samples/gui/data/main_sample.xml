		<ctrl style="text_button_16" id="bt_menu" posref="TL TL" x="12" y="-10" onclick_l="active_menu" params_l="menu=ui:sample:sample_menu" hardtext="Open Menu" />
		<view type="text" id="l0" posparent="bt_menu" posref="MR ML" x="8" y="0" fontsize="14" shadow="true" global_color="false" color="255 255 255 160" hardtext="(or right-click here)" />
		<view type="text" id="l1" posparent="bt_menu" posref="BL TL" x="0" y="-12" fontsize="14" shadow="true" global_color="false" color="255 255 255 200" hardtext="combo box:" />
		<group type="combo_box" id="combo" posparent="l1" posref="BL TL" x="0" y="-4" w="180" h="20" value="UI:TEMP:COMBO">
			<instance template="combo_box_def1" />
