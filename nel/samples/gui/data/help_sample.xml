<interface_config>

<!-- ******************************************************* -->
<!-- * Help viewer                                         * -->
<!-- * A group_html browser over local pages: links fire   * -->
<!-- * the "browse" action handler (embedder-provided,     * -->
<!-- * like the client), pages resolve through the search  * -->
<!-- * path, and Back/Forward ride the widget's undo/redo  * -->
<!-- * history (it freezes the buttons itself).            * -->
<!-- ******************************************************* -->

<group type="container" id="help" w="420" pop_min_w="420" pop_max_w="420" h="440" pop_min_h="440" pop_max_h="440"
	title="Help (group_html)" resizer="true" global_color="false" header_color="UI:SAVE:WIN:COLORS:SAMPLE"
	title_bar_open="false" open_button="false" right_button="true" lockable="false" openable="false"
	opened="true" movable="true" active="false" x="440" y="620">
	<group id="header_closed" x="0" y="0" h="12" posref="TL TL"></group>
	<group id="header_opened" x="0" y="0" w="0" h="16" posref="TL TL"></group>
	<group id="content" x="0" y="0" posref="TL TL" w="0" h="0">
		<ctrl style="text_button_16" id="bt_back" posref="TL TL" x="12" y="-6" onclick_l="browse_undo" params_l="name=ui:sample:help:content:html" hardtext="Back" />
		<ctrl style="text_button_16" id="bt_fwd" posparent="bt_back" posref="MR ML" x="6" y="0" onclick_l="browse_redo" params_l="name=ui:sample:help:content:html" hardtext="Forward" />
		<ctrl style="text_button_16" id="bt_home" posparent="bt_fwd" posref="MR ML" x="6" y="0" onclick_l="browse" params_l="name=ui:sample:help:content:html|url=help_index.html" hardtext="Home" />
		<group type="html" id="html" posref="TL TL" x="8" y="-30" sizeref="wh" w="-16" h="-38"
			url="help_index.html" home="help_index.html" browse_next_time="true" timeout="0"
			background_color="28 28 28 255" error_color="255 110 110 255" link_color="120 170 255 255" text_color="210 210 210 255"
			h1_color="255 255 255 255" h2_color="255 255 255 255" h3_color="255 255 255 255"
			h4_color="255 255 255 255" h5_color="255 255 255 255" h6_color="255 255 255 255"
			text_font_size="12" h1_font_size="18" h2_font_size="16" h3_font_size="14" h4_font_size="13" h5_font_size="12" h6_font_size="12"
			paragraph_begin_space="8" multi_line_space_factor="0.25" td_begin_space="8" li_begin_space="4" ul_begin_space="8" li_indent="0" ul_indent="24"
			checkbox_bitmap_normal="w_slot_on.tga" checkbox_bitmap_pushed="w_opacity_on.tga" checkbox_bitmap_over=""
			background_bitmap_view="black2"
			browse_undo="ui:sample:help:content:bt_back" browse_redo="ui:sample:help:content:bt_fwd">
			<group id="black" posref="BR BR" sizeref="hw" w="0" h="0" />
			<view type="bitmap" id="black2" posparent="black" posref="MM MM" sizeref="wh" w="0" h="0" scale="true" texture="blank.tga" global_color="false" />
			<group type="list" id="text_list" fontsize="12" posref="TL TL" posparent="black" x="6" y="-6" space="0" sizeref="hw" w="-20" h="-12" maxelements="2000" />
			<ctrl type="scroll" id="scroll_bar" align="T" posref="TR TR" x="-2" y="-2" w="8" sizeref="h" h="-4"
				tx_topright="w_scroll_l0_t.tga" tx_middle="w_scroll_l0_m.tga" tx_bottomleft="w_scroll_l0_b.tga" />
		</group>
	</group>
</group>
<tree node="help"></tree>

</interface_config>
